angka = int(input("Masukkan sebuah angka: "))

if angka <= 1:
    print(angka, "bukan bilangan prima")
else:
    prima = True
    for i in range(2, int(angka ** 0.5) + 1):  # cek sampai akar dari angka
        if angka % i == 0:  # kalau habis dibagi, bukan prima
            prima = False
            break
    
    if prima:
        print(angka, "adalah bilangan prima")
    else:
        print(angka, "bukan bilangan prima")